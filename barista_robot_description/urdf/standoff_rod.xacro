<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Single standoff rod, fixed to `parent` at (x, y, 0.120). Material
       "rod_grey" must already be defined in the including file. -->
  <xacro:macro name="standoff_rod" params="link_suffix joint_suffix parent x y">

    <link name="standoff_${link_suffix}">
      <visual>
        <origin xyz="0 0 0.11" rpy="0 0 0"/>
        <geometry><cylinder radius="0.01" length="0.22"/></geometry>
        <material name="rod_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.11" rpy="0 0 0"/>
        <geometry><cylinder radius="0.01" length="0.22"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.11" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0005" ixy="0.0" ixz="0.0" iyy="0.0005" iyz="0.0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="standoff_${joint_suffix}" type="fixed">
      <parent link="${parent}"/>
      <child link="standoff_${link_suffix}"/>
      <origin xyz="${x} ${y} 0.120" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>